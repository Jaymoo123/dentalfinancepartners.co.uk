    "\\bhmrc\\b",
    "\\b(forecast|predict|trend|hottest)\\b",
    "\\b(unclaimed|debt-forces|penalties-for-a-missed)\\b",
    "^(my-experience|why-i-)",
    "-deadline$|-deadline-\\b",
    "\\b(opinions?|opinion-piece|comment|editorial)\\b",
    "\\b(podcast|webinar|video)\\b",
    "^press-release",
    "^how-can-i-",
    "^who-(is|wants|will|gets|owns|owes)",
