# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
!**/public/downloads/
eggs/
.eggs/
# Only ignore Python lib directories at root, not src/lib in web projects
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Environment variables
.env
.env.local
.env.*.local

# Personal expense reconciliation — raw financial exports (PayPal/AMEX/bank CSVs,
# Outlook .pst, Gmail .mbox), generated ledgers, and figure-bearing summary docs stay
# LOCAL, never committed. (Code parsers + README methodology remain committable.)
/expense-reconciliation/data/
/expense-reconciliation/output/
/expense-reconciliation/GOAL.md
/expense-reconciliation/QA_REPORT.md

# Secrets (API keys, service accounts)
secrets/
# Root-level scratch JSON only (2026-08-15: replaced a blanket `*.json` whose
# 10-entry negation list silently swallowed every NEW legitimate JSON until
# someone noticed and added an eleventh). Non-root JSON is tracked by default;
# ignore specific scratch locations below instead.
/*.json
!/package.json
!/package-lock.json
!/tsconfig.json
# Research raw dumps (large, regenerable from source)
/expansion_research/**/*.json
# Brief-building bulk data (discovery packs + competitor dumps, regenerable);
# the tiny wave _signals (sign-off flags, QA verdicts) stay tracked
/briefs/**/*.json
!/briefs/**/_signals/*.json
/briefs/*/discovery_*/
# Niche screener raw output (25 MB, regenerable)
/optimisation_engine/niche_screener/**/*.json
# Dead admin archive
/Admin/**/*.json
# Frozen 2026-06 audit interim dumps + archived script scratch (regenerable)
/docs/property/opportunity_audit_2026-06-04/_*.json
/scripts/_archive/*.json
/docs/backups/

# Logs
*.log
agents/docs/logs/*.log

# Node.js (for Next.js sites)
node_modules/
.next/
out/
*.tsbuildinfo

# Vercel
.vercel

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Claude Code harness state (session, schedule, plans live in ~/.claude not here)
.claude/*
!.claude/settings.json
!.claude/commands/
.claude/commands/.local/

# Per-site IndexNow queues (transient, drained on each --from-queue run)
.indexnow_queue*

# Digital Agency was unified into the monorepo 2026-05-20 via git subtree merge
# (preserved its own commit history at the "Digital Agency/" prefix path).
# No longer excluded.

# Temporary files
*.tmp
*.temp
*.err
*_err.txt
*_tmp_*

# Engine QA/verdict cache (regenerated; never committed)
optimisation_engine/.cache/

# Documentation (keep in repo but ignore editor temp files)
.docs/*.tmp

# Admin documentation
# Admin/*.md files are kept in repo for project documentation

# session scratch (blew Vercel 10MB upload limit 2026-07-09)
.cache/
_audit_digest.txt
icaew_extract.txt
icaew_lines.txt
proposal_engine/out/

# research pipeline raw data dumps (large, regenerable from source)
**/pipeline/raw/
optimisation_engine/niche_screener/generators/raw_reg_churn/

# session scratch
/tmp/

# Lead engine dry-run artefacts (rendered pings/deliveries/invoices; regenerable)
lead_engine/outbox/*
lead_engine/invoices/*
!**/.gitkeep
